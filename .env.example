# ========================================
# 数字助手 - 环境变量配置模板
# ========================================
#
# 使用说明:
# 1. 复制本文件为 `.env.local` (已在 .gitignore 中,不会提交)
# 2. 填写真实的 API Key 和服务地址
# 3. 重启开发服务器 (npm run serve)
#
# 注意:
# - Vue CLI 项目的环境变量必须以 `VUE_APP_` 开头
# - 旧版本硬编码的 Dify Key `app-SzWFJDVQBdNbNP0DrPmu98df` 已泄露到 git 历史,
#   建议在 Dify 控制台轮换新 Key 后填入下方 VUE_APP_LLM_API_KEY
# ========================================

# ==================== ASR (语音识别) ====================
VUE_APP_ASR_TYPE=sensevoice
VUE_APP_ASR_URL=/api/asr
VUE_APP_ASR_LANG=auto

# ==================== LLM (大模型对话) ====================
# 支持 'dify' 或 'coze'
VUE_APP_LLM_PROVIDER=dify

# Dify 配置示例
VUE_APP_LLM_URL=http://192.168.1.168/v1/chat-messages
VUE_APP_LLM_API_KEY=app-SzWFJDVQBdNbNP0DrPmu98df
VUE_APP_LLM_USER_ID=digitalhuman-001

# Coze 配置示例 (如使用 Coze,取消下面注释并填写)
# VUE_APP_LLM_PROVIDER=coze
# VUE_APP_LLM_URL=https://api.coze.cn/v3/chat
# VUE_APP_LLM_API_KEY=your-coze-api-key
# VUE_APP_LLM_BOT_ID=your-bot-id
# VUE_APP_LLM_USER_ID=12345

# ==================== TTS (语音合成) ====================
# 支持 'gpt-sovits' 或 'edge'
VUE_APP_TTS_PROVIDER=gpt-sovits
VUE_APP_TTS_URL=/api/tts
VUE_APP_TTS_REF_AUDIO=examples/dbes01.wav
VUE_APP_TTS_PROMPT_TEXT=欢迎来到南京大报恩寺遗址景区！这里曾是明代皇家寺院，其核心大报恩寺琉璃宝塔被誉为中世纪世界七大奇迹之一。

# ==================== Avatar (数字人模型) ====================
VUE_APP_AVATAR_TYPE=live2d
VUE_APP_AVATAR_MODEL=./models/芍药/芍药身体运动.model3.json
